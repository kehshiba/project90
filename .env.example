# Copy this file to .env.local for local development, then add the same two
# values in Netlify: Site configuration -> Environment variables.
#
# Both values are public and safe to expose in the browser build.
# NEVER put the service_role key in this file or in Netlify.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Leave both blank to run the app in local-only mode (data stays in the browser).
